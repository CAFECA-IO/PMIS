// ─────────────────────────────────────────────────────────────
// 人員管理 (組織 / 職位 / 帳號)
// ─────────────────────────────────────────────────────────────

/// Organisation unit with self-referencing hierarchy (組織).
model OrgUnit {
  id        String    @id @default(cuid())
  name      String
  code      String?
  parentId  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children OrgUnit[] @relation("OrgTree")
  accounts Account[]

  @@index([parentId])
}

/// Job position / title (職位).
model Position {
  id        String    @id @default(cuid())
  name      String
  rank      Int       @default(0)
  modulePermissions String? // JSON：各模組權限 { "/route": "NONE"|"VIEW"|"EDIT" }
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  accounts      Account[]
  workflowSteps ApprovalWorkflowStep[]
  documentSteps ApprovalDocumentStep[]
}

/// User account / personnel (帳號).
model Account {
  id         String        @id @default(cuid())
  name       String
  email      String        @unique
  phone      String?
  role       AccountRole   @default(MEMBER)
  status     AccountStatus @default(ACTIVE)
  orgUnitId  String?
  positionId String?
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  orgUnit  OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  appliedDocuments ApprovalDocument[]     @relation("AppliedDocuments")
  signedSteps      ApprovalDocumentStep[] @relation("SignedSteps")
  projectMembers   ProjectMember[]

  @@index([orgUnitId])
  @@index([positionId])
}

enum AccountRole {
  ADMIN // 系統管理員：不受限，可管理職位權限
  MANAGER // 計畫主管：可見全部專案
  MEMBER // 一般成員：僅見被指派專案；模組操作權限由職位決定
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

// ─────────────────────────────────────────────────────────────
// 簽核管理 (流程範本 / 簽核文件 / 附件)
// ─────────────────────────────────────────────────────────────

/// Approval workflow template (簽核流程範本).
model ApprovalWorkflow {
  id          String                 @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime               @default(now())
  deletedAt   DateTime?
  steps       ApprovalWorkflowStep[]
  documents   ApprovalDocument[]
}

/// A position that must sign at a given order (流程關卡).
model ApprovalWorkflowStep {
  id         String @id @default(cuid())
  workflowId String
  order      Int
  positionId String

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position Position         @relation(fields: [positionId], references: [id])

  @@index([workflowId])
}

/// An approval document routed through a workflow (簽核文件).
model ApprovalDocument {
  id          String                 @id @default(cuid())
  title       String
  description String?
  applicantId String
  workflowId  String
  status      ApprovalStatus         @default(PENDING)
  currentStep Int                    @default(0)
  createdAt   DateTime               @default(now())
  deletedAt   DateTime?

  applicant   Account                @relation("AppliedDocuments", fields: [applicantId], references: [id])
  workflow    ApprovalWorkflow       @relation(fields: [workflowId], references: [id])
  steps       ApprovalDocumentStep[]
  attachments ApprovalAttachment[]

  @@index([applicantId])
  @@index([status])
}

/// A single sign-off step within a document (文件簽核關卡).
model ApprovalDocumentStep {
  id         String       @id @default(cuid())
  documentId String
  order      Int
  positionId String
  signedById String?
  signedAt   DateTime?
  decision   StepDecision @default(PENDING)
  comment    String?

  document ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position Position         @relation(fields: [positionId], references: [id])
  signedBy Account?         @relation("SignedSteps", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([documentId])
}

/// Reference file attached to an approval document (參考文件).
model ApprovalAttachment {
  id         String   @id @default(cuid())
  documentId String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  document ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StepDecision {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// PMIS-12 GIS 地圖（政府圖資套疊 + 專案自訂圖徵）
// ─────────────────────────────────────────────────────────────

/// 專案自訂圖徵（點 / 線 / 面），幾何以 GeoJSON 儲存（WGS84）。
model GisFeature {
  id         String         @id @default(cuid())
  projectId  String
  name       String
  type       GisFeatureType @default(MARKER)
  geojson    String // GeoJSON geometry 字串（WGS84 經緯度）
  color      String? // 顯示顏色（HEX）
  note       String?
  linkModule String? // 關聯模組，如 DEFECT / EHS / INSPECTION
  linkId     String? // 關聯資料 id
  visible    Boolean        @default(true)
  createdBy  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

/// 政府圖資圖層目錄／seed（依類別 × 年份版本化）。
model GisLayerSeed {
  id        String   @id @default(cuid())
  category  String // 主題分組，如 BASE / RISK / FACILITY / LAND / ADMIN
  title     String // 顯示名稱
  source    String // 來源：NLSC / TGOS / SEGIS
  wmtsCode  String? // WMTS 圖層代碼，如 SoilLiquefaction
  format    String   @default("png") // 圖磚格式 png / jpeg
  year      Int // 適用年度
  srs       String   @default("EPSG:3857")
  color     String? // 圖例代表色（前端面板用）
  filePath  String? // 向量 seed（GeoJSON）路徑，圖磚類可空
  opacity   Int      @default(70) // 預設透明度 0-100
  sortOrder Int      @default(0)
  isBase    Boolean  @default(false) // 是否為底圖（單選）
  isDefault Boolean  @default(false) // 預設開啟
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([wmtsCode, year])
  @@index([category])
}

enum GisFeatureType {
  MARKER // 地標（點）
  ROUTE // 路線圖（線）
  AREA // 圈定範圍（面）
}

// ─────────────────────────────────────────────────────────────
// 行事曆與預警：預警規則（固定日期 / 相對日期 / 條件觸發）
// ─────────────────────────────────────────────────────────────

/// 預警規則。projectId 為 null 代表適用於所有專案。
model AlertRule {
  id          String        @id @default(cuid())
  projectId   String?
  name        String
  description String?
  kind        AlertRuleKind
  /// 綁定的功能模組路由，如 /schedule、/submittals、/quality、/monitoring
  module      String
  severity    AlertSeverity @default(WARNING)
  enabled     Boolean       @default(true)

  /// FIXED_DATE：觸發日期
  fixedDate DateTime?

  /// RELATIVE_DATE：相對於哪個基準日、提前幾天
  anchor    AlertAnchor?
  offsetDays Int?

  /// CONDITION：比較的度量、運算子與門檻值
  metric    AlertMetric?
  operator  AlertOperator?
  threshold Float?
  /// 門檻單位（顯示用），如 %、分鐘、次
  unit      String?

  /// 命中後要採取的行動描述（如 建立趕工計畫與每週檢討會）
  action String?
  /// 通知對象，逗號分隔（如 承辦,專案經理）
  notify String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([enabled])
}

enum AlertRuleKind {
  FIXED_DATE // 固定日期
  RELATIVE_DATE // 相對日期
  CONDITION // 條件觸發
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// 相對日期的基準點
enum AlertAnchor {
  CONTRACT_END // 履約完工日
  OBLIGATION_DUE // 履約事項期限
  DOCUMENT_DUE // 文件／送審期限
  INSPECTION_DATE // 查驗預定日
  DEFECT_DUE // 缺失改善期限
}

/// 條件觸發可比較的度量
enum AlertMetric {
  SCHEDULE_LAG // 進度落後百分比
  INSPECTION_FAILED // 查驗不合格件數
  DEFECT_OVERDUE // 逾期未改善缺失件數
  SUBMITTAL_PENDING // 待審送審件數
  DEVICE_OFFLINE_MINUTES // 設備離線分鐘數
  BUDGET_USAGE // 預算使用率
}

enum AlertOperator {
  GTE // >=
  LTE // <=
  GT // >
  LT // <
  EQ // ==
}

/// 現地監測設備（CCTV／感測器）與心跳狀態，供 DEVICE_OFFLINE_MINUTES 條件評估。
model MonitoringDevice {
  id            String       @id @default(cuid())
  projectId     String
  code          String       @unique
  name          String
  type          DeviceType   @default(CCTV)
  location      String?
  status        DeviceStatus @default(ONLINE)
  /// 最後一次心跳時間，離線分鐘數由此推算
  lastHeartbeat DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum DeviceType {
  CCTV
  SENSOR
  GATEWAY
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}
