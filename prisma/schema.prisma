// PMIS — AI-Powered Construction Supervision
// Prisma 7 schema. The datasource URL lives in prisma.config.ts.
// Models are organised by the 8 functional modules (PMIS-01 ~ PMIS-08).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Core hub — Project (PMIS-03 契約履約管理 base)
// ─────────────────────────────────────────────────────────────

/// A construction project under supervision.
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  /// 工程摘要：工程性質與主要工項（兩三句）
  description String?
  /// 關鍵要求重點：契約與規範中影響施工方式的關鍵條件。
  /// 例如分段施工、汛期限制、交通維持、鄰房保護、夜間施工限制、特殊工法或材料要求。
  /// 建立專案時一併記錄，後續產生施工設計與 3D 數位孿生動畫時作為依據。
  keyRequirements String?
  location    String?
  contractNo  String?
  client      String?
  contractor  String?
  supervisor  String?
  budget      Decimal?
  floorArea   Decimal? // 樓地板面積 (m²)，供碳排強度基準使用
  lat         Float? // 工地緯度 (WGS84)，供 PMIS-12 GIS 地圖定位
  lng         Float? // 工地經度 (WGS84)
  startDate   DateTime?
  endDate     DateTime?
  /// 契約簽訂日。履約事項的相對期限常自簽約日起算，且不必等於開工日
  signedDate DateTime?
  /// 開工命令日（機關通知開工之日），同樣是常見的期限起算基準
  noticeDate DateTime?
  /// 契約工期（工作天）。監造月報的累積／剩餘工期以此為分母；
  /// 「工作天」與「日曆天」在契約上不同義，故不可由起訖日期相減推得。
  contractWorkDays Int?
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  workItems         WorkItem[]
  inspections       Inspection[]
  defects           Defect[]
  contractChanges   ContractChange[]
  obligations       ContractObligation[]
  scopeItems        ContractScopeItem[]
  paymentNodes      PaymentNode[]
  documents         ProjectDocument[]
  reminders         ReminderEvent[]
  notifications     Notification[]
  alertRules        AlertRule[]
  devices           MonitoringDevice[]
  ehsAudits         EhsAudit[]
  submittals        Submittal[]
  mediaAssets       MediaAsset[]
  supervisionReports SupervisionReport[]
  members           ProjectMember[]
  carbonInventories CarbonInventory[]
  vouchers          FinancialVoucher[]
  gisFeatures       GisFeature[]
  faithUploads      FaithUpload[]
  fileFolders       FileFolder[]
  projectFiles      ProjectFile[]
  designVersions    DesignVersion[]
}

/// Staffing — links an account to a project with a project-scoped role (配置人力).
model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  accountId String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@index([projectId])
  @@index([accountId])
}

enum ProjectMemberRole {
  MANAGER
  SUPERVISOR
  INSPECTOR
  MEMBER
}

// ─────────────────────────────────────────────────────────────
// PMIS-10 溫室氣體碳盤查 (GHG Protocol / ISO 14064-1)
// ─────────────────────────────────────────────────────────────

/// 排放係數版本集（如「環境部排放係數管理表 6.0.4」），支援多版本並存與切換。
model EmissionFactorSet {
  id        String   @id @default(cuid())
  name      String
  version   String // 版本號，如 6.0.4
  year      Int // 適用年度
  gwpSet    String // AR5 / AR6
  source    String // 如：環境部
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  factors     EmissionFactor[]
  inventories CarbonInventory[]
}

/// 排放源類別（版本無關，如：柴油、外購電力、卜特蘭水泥）。
model EmissionCategory {
  id     String      @id @default(cuid())
  scope  CarbonScope
  name   String
  unit   String // 基準單位
  active Boolean     @default(true)

  factors EmissionFactor[]
  entries CarbonEntry[]
}

/// 排放係數（隸屬某版本集之下的某類別）。
model EmissionFactor {
  id         String   @id @default(cuid())
  setId      String
  categoryId String
  value      Decimal // kgCO₂e / unit
  unit       String
  createdAt  DateTime @default(now())

  set      EmissionFactorSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  category EmissionCategory  @relation(fields: [categoryId], references: [id])
  entries  CarbonEntry[]

  @@unique([setId, categoryId])
  @@index([categoryId])
}

/// 單一專案的一次盤查（可依年度/期別分次）。
model CarbonInventory {
  id            String               @id @default(cuid())
  projectId     String
  factorSetId   String? // 本次盤查採用的係數版本
  name          String
  periodStart   DateTime?
  periodEnd     DateTime?
  baselineCo2e  Decimal? // 基準值 (tCO₂e)
  targetCo2e    Decimal? // 減量目標 (tCO₂e)
  intensityBasis CarbonIntensityBasis @default(CONTRACT_AMOUNT)
  verifier      String? // 第三方查證機構
  verifiedAt    DateTime?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  factorSet EmissionFactorSet? @relation(fields: [factorSetId], references: [id])
  entries   CarbonEntry[]
  auditLogs CarbonAuditLog[]

  @@index([projectId])
}

/// 單筆活動數據記錄（活動量 × 排放係數 = 排放量）。
model CarbonEntry {
  id           String            @id @default(cuid())
  inventoryId  String
  scope        CarbonScope
  categoryId   String
  factorId     String?
  workItemId   String?
  activityQty  Decimal // 活動數據數量
  activityUnit String // 輸入單位
  factorValue  Decimal // 計算當下的係數快照 (kgCO₂e/unit)
  co2e         Decimal // 計算結果 (kgCO₂e)
  status       CarbonEntryStatus @default(DRAFT)
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證自動擷取
  occurredAt   DateTime?
  evidenceUrl  String? // 憑證/發票連結
  verifiedById String? // 查證人 (Account)
  verifiedAt   DateTime?
  note         String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  inventory CarbonInventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  category  EmissionCategory @relation(fields: [categoryId], references: [id])
  factor    EmissionFactor?  @relation(fields: [factorId], references: [id])
  workItem  WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([scope])
}

/// 稽核軌跡：記錄盤查/記錄的建立、確認、查證、刪除等動作。
model CarbonAuditLog {
  id          String             @id @default(cuid())
  inventoryId String
  entryId     String? // 針對哪一筆記錄（可空 = 針對整份盤查）
  action      String // CREATE / UPDATE / CONFIRM / VERIFY / DELETE / RESTORE
  actorId     String? // Account id
  actorName   String?
  fromStatus  CarbonEntryStatus?
  toStatus    CarbonEntryStatus?
  detail      String?
  createdAt   DateTime           @default(now())

  inventory CarbonInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([entryId])
}

enum CarbonScope {
  SCOPE_1 // 直接排放
  SCOPE_2 // 外購電力
  SCOPE_3 // 上下游
}

enum CarbonEntryStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
  VERIFIED // 已查證
}

enum CarbonIntensityBasis {
  CONTRACT_AMOUNT // 契約金額（預設）
  FLOOR_AREA // 樓地板面積
  DURATION // 工期
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 財務管理（會計傳票／專案損益／現金水位）
// ─────────────────────────────────────────────────────────────

/// 會計傳票（可由憑證經費思自動轉換產生）。
model FinancialVoucher {
  id           String            @id @default(cuid())
  projectId    String
  voucherNo    String? // 傳票號
  date         DateTime
  direction    FinancialDirection
  category     String // 科目／類別，如 工程款、材料、人工、機具、管理費、稅費
  amount       Decimal
  cashFlow     Boolean           @default(true) // 是否影響現金水位
  counterparty String? // 對象（廠商／機關）
  summary      String?
  evidenceUrl  String? // 憑證連結
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證擷取
  status       VoucherStatus     @default(DRAFT)
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([direction])
}

enum FinancialDirection {
  INCOME // 收入
  EXPENSE // 支出
}

enum VoucherStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
}

// ─────────────────────────────────────────────────────────────
// PMIS-04 時程進度管理
// ─────────────────────────────────────────────────────────────

/// 工程分項：專案下的施工項目，歸屬於某一履約事項。
model WorkItem {
  id           String         @id @default(cuid())
  projectId    String
  obligationId String? // 歸屬履約事項（工程分項→履約事項上捲，選填）
  scopeItemId  String? // 推導來源的契約履約標的（可溯源）
  workPackage  String? // 所屬工程項目（規劃階段的分群，非獨立層級）
  code         String?
  name         String
  category     String?
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  /// 人工填報進度（0-100）。
  ///
  /// 決策 F（2026-08-05）：本欄是**未計量工項**（無 contractQty／unit，
  /// 例如自表單新增而尚未登錄數量者）的唯一進度來源，亦為已計量工項的後備值。
  /// 已計量工項的進度以數量推導為準，見 work-item-effective.effectiveProgress；
  /// 推導值刻意**不回寫**本欄，故本欄不代表當前有效進度。
  /// 下游（S 曲線、履約事項上捲）應讀有效進度而非本欄。
  progress     Int            @default(0)
  status       WorkItemStatus @default(NOT_STARTED)

  // ── 數量與估驗（詳細工項數量與估驗台帳）──────────────────
  // 一項工程分項在台帳上就是一列價目。以下六欄是資料，
  // 契約複價（數量×單價）與完成率一律推導，不另存欄位 ——
  // 存了就會出現「金額與數量對不起來」而無從判斷誰是真的。
  wbsCode      String? // 台帳上的 WBS 代碼，如 WBS-2.1
  wbsCategory  String? // WBS 類別 id（土建／管線／機械／電氣儀控／職安環保／間接費）
  unit         String? // 計量單位，如 m3、m、組、式
  contractQty  Decimal? // 契約數量
  unitPrice    Decimal? // 單價
  /// 期初累計完成量。
  ///
  /// 語意已於 2026-08-05（決策 A）改變：此欄不再是「當前累計完成量」，
  /// 而是「開始以日報填報之前的累計基準」。當前有效累計量為
  ///   期初(本欄) + Σ 日報 SupervisionReportItem.dailyQty
  /// 由 work-item-effective.effectiveCompletedQty 推導，不回寫本欄。
  /// 人工寫入入口已關閉（台帳改唯讀），避免與日報加總並存成為第二個來源。
  completedQty Decimal?
  inspectedQty Decimal? // 查驗合格量
  valuatedQty  Decimal? // 累計估驗量

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  obligation   ContractObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  scopeItem    ContractScopeItem?  @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)
  inspections  Inspection[]
  defects      Defect[]
  carbonEntries CarbonEntry[]
  /// 日報數量表中引用本分項的列（累計完成量的來源）。
  reportItems  SupervisionReportItem[]

  @@index([projectId])
  @@index([obligationId])
  @@index([scopeItemId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-07 品質稽核管理 (施工查驗 + 缺失)
// ─────────────────────────────────────────────────────────────

/// An inspection / acceptance check (查驗).
model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  workItemId  String?
  type        InspectionType   @default(PROCESS)
  scheduledAt DateTime
  inspector   String?
  result      InspectionResult @default(PENDING)
  location    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  defects  Defect[]

  @@index([projectId])
  @@index([workItemId])
}

/// A quality/safety defect raised during supervision (缺失).
model Defect {
  id           String         @id @default(cuid())
  projectId    String
  workItemId   String?
  inspectionId String?
  title        String
  description  String?
  severity     DefectSeverity @default(MEDIUM)
  status       DefectStatus   @default(OPEN)
  reportedBy   String?
  assignedTo   String?
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem   WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-03 契約履約管理 (變更 / 履約事項 / 付款節點)
// ─────────────────────────────────────────────────────────────

/// Contract change record (契約變更).
model ContractChange {
  id          String    @id @default(cuid())
  projectId   String
  sequence    Int // 變更次數
  description String
  amountAfter Decimal? // 變更後契約金額
  daysChanged Int? // 變更天數
  approvedDate DateTime?
  docNo       String? // 核准文號
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Contract & project document (契約與文件).
model ProjectDocument {
  id         String                  @id @default(cuid())
  projectId  String
  category   ProjectDocumentCategory @default(CONTRACT)
  name       String
  fileNo     String?
  url        String?
  issuedDate DateTime?
  note       String?
  createdAt  DateTime                @default(now())
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// 履約事項：契約應辦事項的統一管制單位。
/// 同時承接進度權重角色——工程分項上捲至此，據以計算全案進度。
/// 契約「履約標的」條所列的工作項目。
///
/// 為何獨立成表：履約事項與工程分項都由此推導，存下來才能回答
/// 「這項工作來自契約哪一條」。先前它只是解析過程的暫存物，
/// 關掉畫面就消失，也無法分階段重跑而不動上游。
model ContractScopeItem {
  id        String @id @default(cuid())
  projectId String

  /// 契約項次編號，如 (一)1、1.2；契約未編號則留空
  code  String?
  /// 工作項目名稱，照抄契約用語
  title String
  /// 出處條次，如 第二條 履約標的
  sourceClause String?
  /// 契約中的排列順序，用於還原原始清單
  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  obligations ContractObligation[]
  workItems   WorkItem[]

  @@index([projectId])
}

/// 3D 施工設計的一個版本（由費思生成，PMIS-01 總覽與決策）。
///
/// 每次生成或修訂都留下一版，使用者可切換版本、基於某版繼續更新或完全重做。
/// html 是可直接以 iframe 嵌入的完整網頁；design 是同一次產出的結構化設計
/// （工程分項與里程碑）的 JSON 文字 —— 存字串而非 Json 型別，與本 schema
/// 其餘部分一致（SQLite，全庫未使用 Json 欄位）。
model DesignVersion {
  id        String @id @default(cuid())
  projectId String

  /// 版本序號，同一專案內由 1 起遞增
  version Int
  /// 費思產生的完整動畫網頁（HTML 原始碼）
  html String
  /// 結構化施工設計的 JSON 文字（workItems 與 milestones）
  design String
  /// 費思對本次設計的說明
  summary String?
  /// 使用者本次要求的調整內容；完全重做時留空
  instruction String?
  /// 基於哪一版修訂而來；完全重做則為 null
  baseVersion Int?
  /// 產生者
  createdById String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Account? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, version])
  @@index([projectId])
}

model ContractObligation {
  id        String @id @default(cuid())
  projectId String

  code  String // 管制編號，如 WURI-C-001
  title String // 履約事項名稱

  stage       ObligationStage // 階段：概念設計／統包招標／施工監造…
  risk        ObligationRisk    @default(GREEN) // 風險燈號
  triggerType ObligationTrigger @default(FIXED_DATE) // 觸發方式
  status      ObligationStatus  @default(NOT_STARTED)

  dueDate    DateTime? // 期限
  actualDate DateTime? // 實際完成日（進度計算用）

  ownerUnit     String? // 責任單位
  ownerName     String? // 責任人
  contractBasis String? // 契約依據，如 契約第二條第八款

  /// 進度權重；工程分項上捲後依此加權計算全案進度
  weight Int @default(1)
  /// 計入試運轉就緒度
  commissioning Boolean @default(false)

  /// 偏移天數：相對期限與前置事項共用，負數代表基準點之前
  offsetDays Int?

  // ── 觸發設定（決定期限如何得出）──────────────────────────
  // 四種觸發方式各需不同的輸入。先前四種都只有一個日期欄位，於是
  // 相對期限、前置事項、條件觸發的依據無處可存，契約工期一改就沒人
  // 知道哪些期限該跟著動。
  /// 相對期限的基準點（PROJECT_START／CONTRACT_SIGNED／MONTHLY…）
  relativeAnchor String?
  /// 前置事項；被指定者刪除時僅解除關聯，不連帶刪除本事項
  predecessorId String?
  /// 條件類型（AGENCY_ACTION／WORK_EVENT／THRESHOLD）
  conditionKind String?
  /// 條件說明（取自該類型的可選模式）
  conditionDetail String?
  /// 期限經人工指定，不隨觸發設定重新推算
  dueDateOverridden Boolean @default(false)

  docNo String? // 核准文號（展延）
  note  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// 推導來源的契約履約標的（可溯源）；來源被刪除時僅解除關聯
  scopeItemId String?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeItem ContractScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)
  workItems WorkItem[] // 歸屬此履約事項的工程分項

  /// 前置事項的自我關聯：甲以乙為前置時，乙延期則甲的期限跟著動
  predecessor ContractObligation?  @relation("ObligationChain", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors  ContractObligation[] @relation("ObligationChain")

  @@unique([projectId, code])
  @@index([projectId])
  @@index([status])
  @@index([stage])
  @@index([scopeItemId])
  @@index([predecessorId])
}

/// 履約事項所屬階段
enum ObligationStage {
  CONCEPT_DESIGN // 概念設計
  DETAIL_DESIGN // 細部設計
  TENDER // 統包招標
  CONSTRUCTION // 施工監造
  COMMISSIONING // 試運轉
  HANDOVER // 竣工移交
  OTHER // 其他
}

/// 風險燈號。PURPLE 用於受外部機關進度牽制者。
enum ObligationRisk {
  GREEN // 低
  YELLOW // 中
  ORANGE // 偏高
  RED // 高
  PURPLE // 外部依賴
}

/// 觸發方式
enum ObligationTrigger {
  FIXED_DATE // 固定日期
  RELATIVE_DUE // 相對期限
  PREDECESSOR // 前置事項完成後起算
  CONDITION // 條件觸發
}

/// 辦理狀態
enum ObligationStatus {
  NOT_STARTED // 未起算
  IN_PROGRESS // 辦理中
  PENDING_REVIEW // 待審
  PENDING_EXTERNAL // 待機關（外部）
  OVERDUE // 逾期
  DONE // 完成
}

/// Payment / valuation node (付款節點 / 計價).
model PaymentNode {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  amount      Decimal?
  plannedDate DateTime?
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-01 行事曆提醒及預警
// ─────────────────────────────────────────────────────────────

/// Calendar event / reminder (行事曆事件與預警).
model ReminderEvent {
  id        String           @id @default(cuid())
  projectId String
  title     String
  category  ReminderCategory @default(OTHER)
  dueDate   DateTime
  status    ReminderStatus   @default(UPCOMING)
  note      String?
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────
// PMIS-02 系統通知
// ─────────────────────────────────────────────────────────────

/// 系統通知。以鈴鐺與未讀數呈現，可展開細節、釘選並前往對應模組。
model Notification {
  id        String     @id @default(cuid())
  projectId String
  title     String
  detail    String? // 通知細節（展開後顯示）
  link      String? // 前往對應功能的路由，如 /quality?project=xxx
  unit      String? // 負責單位
  assignee  String?
  source    String? // 來源 (缺失 / 退件 / 待簽核…)
  dueDate   DateTime?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime? // 已讀時間
  pinnedAt  DateTime? // 釘選時間；非 null 表示固定顯示於釘選區
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([pinnedAt])
}

// ─────────────────────────────────────────────────────────────
// PMIS-05 環安衛管理
// ─────────────────────────────────────────────────────────────

/// Environment / Health & Safety / Traffic audit (環安衛稽核).
model EhsAudit {
  id         String    @id @default(cuid())
  projectId  String
  type       EhsType   @default(SAFETY)
  auditedAt  DateTime
  inspector  String?
  location   String?
  result     EhsResult @default(PENDING)
  findings   String? // 缺失情形
  dueDate    DateTime? // 改善期限
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments EhsAttachment[]
  notes       EhsNote[]

  @@index([projectId])
  @@index([type])
}

/// 檔案管理（PMIS-13）的資料夾。以專案為根目錄，parentId 為 null 即位於根層。
/// 既有模組的附件（環安衛、簽核、費思）不進此表，於讀取時以唯讀虛擬資料夾呈現，
/// 因為那些檔案被稽核與簽核紀錄引用，不應被自由搬移或刪除。
model FileFolder {
  id        String  @id @default(cuid())
  projectId String
  parentId  String?
  name      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    ProjectFile[]

  /// 同一層不得同名；上傳時的重名由服務層自動加序號後才寫入。
  @@unique([projectId, parentId, name])
  @@index([projectId])
  @@index([parentId])
}

/// 直接上傳到檔案管理的檔案。位元組存於儲存區（storage.service），此處僅中繼資料。
model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  /// null 表示位於專案根目錄。
  folderId  String?

  fileName   String
  storedName String
  mimeType   String
  size       Int

  uploadedById String?
  uploadedBy   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  FileFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
}

/// 費思 AI 對話中上傳的檔案歸檔。
/// 位元組存於本機儲存區（見 storage.service），此處僅保存中繼資料，
/// 欄位刻意與 SavedFile 對齊（fileName/storedName/mimeType/size）。
/// projectId 可為 null —— 對話未鎖定專案時歸入「未指派」，事後可補指派。
model FaithUpload {
  id        String  @id @default(cuid())
  projectId String?

  fileName   String // 使用者原始檔名
  storedName String // 儲存區內的不透明檔名
  mimeType   String
  size       Int

  /// 來源任務 id（如 project-wizard）；一般對話為 null。
  taskId    String?
  /// 來源任務名稱，供資料庫頁顯示來源脈絡。
  taskTitle String?
  /// 上傳時附帶的使用者訊息（截斷保存），用以回溯當時的意圖。
  prompt String?

  /// 上傳者。保留 id 以便「未指派專案」時仍能判定存取權。
  uploadedById String?
  uploadedBy   String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedById])
  @@index([createdAt])
}

/// 環安衛稽核之上傳／拍攝文件。
model EhsAttachment {
  id         String   @id @default(cuid())
  auditId    String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

/// 環安衛稽核之追蹤紀錄（改善進度、備註）。
model EhsNote {
  id         String   @id @default(cuid())
  auditId    String
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-06 送審文件材料管理
// ─────────────────────────────────────────────────────────────

/// Submittal for design / construction / material / test report (送審).
model Submittal {
  id                String            @id @default(cuid())
  projectId         String
  category          SubmittalCategory @default(MATERIAL)
  name              String
  materialName      String?
  plannedSubmitDate DateTime?
  actualSubmitDate  DateTime?
  reviewDate        DateTime?
  reviewResult      ReviewResult      @default(PENDING)
  status            SubmittalStatus   @default(DRAFT)
  fileNo            String? // 歸檔編號
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 文件/照片/影片資料庫 + 監造報表
// ─────────────────────────────────────────────────────────────

/// Media / document asset (文件 / 照片 / 影片).
model MediaAsset {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  type       MediaType @default(PHOTO)
  category   String?
  fileUrl    String?
  fileSizeKb Int?
  uploadedBy String?
  capturedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

/// Daily supervision report (監造報表).
model SupervisionReport {
  id         String       @id @default(cuid())
  projectId  String
  reportDate DateTime
  weather    String?
  summary    String? // 按圖施工概況
  manpower   String? // 工地人員及機具
  equipment  String?
  keyNotes   String? // 重要事項
  filedBy    String?
  status     ReportStatus @default(DRAFT)
  createdAt  DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 數量表：本日各施工項目的完成數量。
  items   SupervisionReportItem[]

  @@unique([projectId, reportDate])
  @@index([projectId])
}

/// 監造日報的數量表一列（E1）。
///
/// 只存「本日完成量」，不存累計 —— 累計 = 期初 + Σ 本日。
/// 兩者都存必然對不起來，而對帳時無從判斷哪個是真的
/// （與 WorkItem 數量欄位「推導而不儲存」的原則一致）。
///
/// 依決策 A，本表的加總是月報累計完成量與逐工項本期完成的**權威來源**，
/// 取代原先規劃的 WorkItemPeriodSnapshot 月結快照。
model SupervisionReportItem {
  id       String @id @default(cuid())
  reportId String

  /// 對應的工程分項。
  ///
  /// 允許為 null 以容納契約外的臨時項目（如未登錄於台帳的「化冀池打除」）。
  /// null 的列僅存在於該日報中，**不計入任何工項的累計量**
  /// —— 否則日報會成為繞過契約管控、憑空建立工項的旁路。
  workItemId String?

  /// 施工項目名稱快照。
  ///
  /// 刻意複製而非僅靠關聯：工程分項日後更名或刪除後，
  /// 歷史日報仍須還原當時的內容（法定文件不可回溯改寫）。
  itemName String
  /// 計量單位快照；應取自 WorkItem.unit，不由使用者自填，
  /// 否則同一工項在不同日報用不同單位而無法加總。
  unit     String?
  /// 本日完成數量。
  dailyQty Decimal
  note     String?
  /// 表單與報表中的排列順序。
  sortOrder Int @default(0)

  report   SupervisionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// SetNull 而非 Cascade：工項被刪除時，該日的施工紀錄仍是法定文件的一部分，
  /// 應保留並以 itemName 快照呈現，不可連帶消失。
  workItem WorkItem?         @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([workItemId])
}

