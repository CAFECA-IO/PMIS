// PMIS — AI-Powered Construction Supervision
// Prisma 7 schema. The datasource URL lives in prisma.config.ts.
// Models are organised by the 8 functional modules (PMIS-01 ~ PMIS-08).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Core hub — Project (PMIS-03 契約履約管理 base)
// ─────────────────────────────────────────────────────────────

/// A construction project under supervision.
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  location    String?
  contractNo  String?
  client      String?
  contractor  String?
  supervisor  String?
  budget      Decimal?
  floorArea   Decimal? // 樓地板面積 (m²)，供碳排強度基準使用
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  workItems         WorkItem[]
  inspections       Inspection[]
  defects           Defect[]
  contractChanges   ContractChange[]
  milestones        Milestone[]
  paymentNodes      PaymentNode[]
  documents         ProjectDocument[]
  reminders         ReminderEvent[]
  todos             TodoItem[]
  ehsAudits         EhsAudit[]
  submittals        Submittal[]
  mediaAssets       MediaAsset[]
  supervisionReports SupervisionReport[]
  members           ProjectMember[]
  carbonInventories CarbonInventory[]
  vouchers          FinancialVoucher[]
}

/// Staffing — links an account to a project with a project-scoped role (配置人力).
model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  accountId String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@index([projectId])
  @@index([accountId])
}

enum ProjectMemberRole {
  MANAGER
  SUPERVISOR
  INSPECTOR
  MEMBER
}

// ─────────────────────────────────────────────────────────────
// PMIS-10 溫室氣體碳盤查 (GHG Protocol / ISO 14064-1)
// ─────────────────────────────────────────────────────────────

/// 排放係數版本集（如「環境部排放係數管理表 6.0.4」），支援多版本並存與切換。
model EmissionFactorSet {
  id        String   @id @default(cuid())
  name      String
  version   String // 版本號，如 6.0.4
  year      Int // 適用年度
  gwpSet    String // AR5 / AR6
  source    String // 如：環境部
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  factors     EmissionFactor[]
  inventories CarbonInventory[]
}

/// 排放源類別（版本無關，如：柴油、外購電力、卜特蘭水泥）。
model EmissionCategory {
  id     String      @id @default(cuid())
  scope  CarbonScope
  name   String
  unit   String // 基準單位
  active Boolean     @default(true)

  factors EmissionFactor[]
  entries CarbonEntry[]
}

/// 排放係數（隸屬某版本集之下的某類別）。
model EmissionFactor {
  id         String   @id @default(cuid())
  setId      String
  categoryId String
  value      Decimal // kgCO₂e / unit
  unit       String
  createdAt  DateTime @default(now())

  set      EmissionFactorSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  category EmissionCategory  @relation(fields: [categoryId], references: [id])
  entries  CarbonEntry[]

  @@unique([setId, categoryId])
  @@index([categoryId])
}

/// 單一專案的一次盤查（可依年度/期別分次）。
model CarbonInventory {
  id            String               @id @default(cuid())
  projectId     String
  factorSetId   String? // 本次盤查採用的係數版本
  name          String
  periodStart   DateTime?
  periodEnd     DateTime?
  baselineCo2e  Decimal? // 基準值 (tCO₂e)
  targetCo2e    Decimal? // 減量目標 (tCO₂e)
  intensityBasis CarbonIntensityBasis @default(CONTRACT_AMOUNT)
  verifier      String? // 第三方查證機構
  verifiedAt    DateTime?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  factorSet EmissionFactorSet? @relation(fields: [factorSetId], references: [id])
  entries   CarbonEntry[]
  auditLogs CarbonAuditLog[]

  @@index([projectId])
}

/// 單筆活動數據記錄（活動量 × 排放係數 = 排放量）。
model CarbonEntry {
  id           String            @id @default(cuid())
  inventoryId  String
  scope        CarbonScope
  categoryId   String
  factorId     String?
  workItemId   String?
  activityQty  Decimal // 活動數據數量
  activityUnit String // 輸入單位
  factorValue  Decimal // 計算當下的係數快照 (kgCO₂e/unit)
  co2e         Decimal // 計算結果 (kgCO₂e)
  status       CarbonEntryStatus @default(DRAFT)
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證自動擷取
  occurredAt   DateTime?
  evidenceUrl  String? // 憑證/發票連結
  verifiedById String? // 查證人 (Account)
  verifiedAt   DateTime?
  note         String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  inventory CarbonInventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  category  EmissionCategory @relation(fields: [categoryId], references: [id])
  factor    EmissionFactor?  @relation(fields: [factorId], references: [id])
  workItem  WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([scope])
}

/// 稽核軌跡：記錄盤查/記錄的建立、確認、查證、刪除等動作。
model CarbonAuditLog {
  id          String             @id @default(cuid())
  inventoryId String
  entryId     String? // 針對哪一筆記錄（可空 = 針對整份盤查）
  action      String // CREATE / UPDATE / CONFIRM / VERIFY / DELETE / RESTORE
  actorId     String? // Account id
  actorName   String?
  fromStatus  CarbonEntryStatus?
  toStatus    CarbonEntryStatus?
  detail      String?
  createdAt   DateTime           @default(now())

  inventory CarbonInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([entryId])
}

enum CarbonScope {
  SCOPE_1 // 直接排放
  SCOPE_2 // 外購電力
  SCOPE_3 // 上下游
}

enum CarbonEntryStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
  VERIFIED // 已查證
}

enum CarbonIntensityBasis {
  CONTRACT_AMOUNT // 契約金額（預設）
  FLOOR_AREA // 樓地板面積
  DURATION // 工期
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 財務管理（會計傳票／專案損益／現金水位）
// ─────────────────────────────────────────────────────────────

/// 會計傳票（可由憑證經費思自動轉換產生）。
model FinancialVoucher {
  id           String            @id @default(cuid())
  projectId    String
  voucherNo    String? // 傳票號
  date         DateTime
  direction    FinancialDirection
  category     String // 科目／類別，如 工程款、材料、人工、機具、管理費、稅費
  amount       Decimal
  cashFlow     Boolean           @default(true) // 是否影響現金水位
  counterparty String? // 對象（廠商／機關）
  summary      String?
  evidenceUrl  String? // 憑證連結
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證擷取
  status       VoucherStatus     @default(DRAFT)
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([direction])
}

enum FinancialDirection {
  INCOME // 收入
  EXPENSE // 支出
}

enum VoucherStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
}

// ─────────────────────────────────────────────────────────────
// PMIS-04 時程進度管理
// ─────────────────────────────────────────────────────────────

/// A work item / sub-work within a project (分項工程).
model WorkItem {
  id           String         @id @default(cuid())
  projectId    String
  code         String?
  name         String
  category     String?
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  progress     Int            @default(0) // percent 0-100
  status       WorkItemStatus @default(NOT_STARTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspections  Inspection[]
  defects      Defect[]
  carbonEntries CarbonEntry[]

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-07 品質稽核管理 (施工查驗 + 缺失)
// ─────────────────────────────────────────────────────────────

/// An inspection / acceptance check (查驗).
model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  workItemId  String?
  type        InspectionType   @default(PROCESS)
  scheduledAt DateTime
  inspector   String?
  result      InspectionResult @default(PENDING)
  location    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  defects  Defect[]

  @@index([projectId])
  @@index([workItemId])
}

/// A quality/safety defect raised during supervision (缺失).
model Defect {
  id           String         @id @default(cuid())
  projectId    String
  workItemId   String?
  inspectionId String?
  title        String
  description  String?
  severity     DefectSeverity @default(MEDIUM)
  status       DefectStatus   @default(OPEN)
  reportedBy   String?
  assignedTo   String?
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem   WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-03 契約履約管理 (變更 / 里程碑 / 付款節點)
// ─────────────────────────────────────────────────────────────

/// Contract change record (契約變更).
model ContractChange {
  id          String    @id @default(cuid())
  projectId   String
  sequence    Int // 變更次數
  description String
  amountAfter Decimal? // 變更後契約金額
  daysChanged Int? // 變更天數
  approvedDate DateTime?
  docNo       String? // 核准文號
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Contract & project document (契約與文件).
model ProjectDocument {
  id         String                  @id @default(cuid())
  projectId  String
  category   ProjectDocumentCategory @default(CONTRACT)
  name       String
  fileNo     String?
  url        String?
  issuedDate DateTime?
  note       String?
  createdAt  DateTime                @default(now())
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Schedule milestone or extension (工期里程碑 / 展延).
model Milestone {
  id          String        @id @default(cuid())
  projectId   String
  name          String
  type          MilestoneType @default(MILESTONE)
  plannedDate   DateTime?
  actualDate    DateTime?
  weight        Int           @default(1) // 進度權重
  commissioning Boolean       @default(false) // 計入試運轉就緒度
  docNo         String? // 核准文號 (展延)
  note          String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Payment / valuation node (付款節點 / 計價).
model PaymentNode {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  amount      Decimal?
  plannedDate DateTime?
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-01 行事曆提醒及預警
// ─────────────────────────────────────────────────────────────

/// Calendar event / reminder (行事曆事件與預警).
model ReminderEvent {
  id        String           @id @default(cuid())
  projectId String
  title     String
  category  ReminderCategory @default(OTHER)
  dueDate   DateTime
  status    ReminderStatus   @default(UPCOMING)
  note      String?
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────
// PMIS-02 待辦事項追蹤
// ─────────────────────────────────────────────────────────────

/// Cross-unit to-do / follow-up item (待辦事項).
model TodoItem {
  id        String     @id @default(cuid())
  projectId String
  title     String
  unit      String? // 負責單位
  assignee  String?
  source    String? // 來源 (缺失 / 退件 / 待簽核…)
  dueDate   DateTime?
  status    TodoStatus @default(PENDING)
  readAt    DateTime? // 已讀時間
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-05 環安衛管理
// ─────────────────────────────────────────────────────────────

/// Environment / Health & Safety / Traffic audit (環安衛稽核).
model EhsAudit {
  id         String    @id @default(cuid())
  projectId  String
  type       EhsType   @default(SAFETY)
  auditedAt  DateTime
  inspector  String?
  location   String?
  result     EhsResult @default(PENDING)
  findings   String? // 缺失情形
  dueDate    DateTime? // 改善期限
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments EhsAttachment[]
  notes       EhsNote[]

  @@index([projectId])
  @@index([type])
}

/// 環安衛稽核之上傳／拍攝文件。
model EhsAttachment {
  id         String   @id @default(cuid())
  auditId    String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

/// 環安衛稽核之追蹤紀錄（改善進度、備註）。
model EhsNote {
  id         String   @id @default(cuid())
  auditId    String
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-06 送審文件材料管理
// ─────────────────────────────────────────────────────────────

/// Submittal for design / construction / material / test report (送審).
model Submittal {
  id                String            @id @default(cuid())
  projectId         String
  category          SubmittalCategory @default(MATERIAL)
  name              String
  materialName      String?
  plannedSubmitDate DateTime?
  actualSubmitDate  DateTime?
  reviewDate        DateTime?
  reviewResult      ReviewResult      @default(PENDING)
  status            SubmittalStatus   @default(DRAFT)
  fileNo            String? // 歸檔編號
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 文件/照片/影片資料庫 + 監造報表
// ─────────────────────────────────────────────────────────────

/// Media / document asset (文件 / 照片 / 影片).
model MediaAsset {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  type       MediaType @default(PHOTO)
  category   String?
  fileUrl    String?
  fileSizeKb Int?
  uploadedBy String?
  capturedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

/// Daily supervision report (監造報表).
model SupervisionReport {
  id         String       @id @default(cuid())
  projectId  String
  reportDate DateTime
  weather    String?
  summary    String? // 按圖施工概況
  manpower   String? // 工地人員及機具
  equipment  String?
  keyNotes   String? // 重要事項
  filedBy    String?
  status     ReportStatus @default(DRAFT)
  createdAt  DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportDate])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum InspectionType {
  MATERIAL
  PROCESS
  ACCEPTANCE
  SAFETY
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MilestoneType {
  MILESTONE
  EXTENSION
}

enum ProjectDocumentCategory {
  CONTRACT
  AMENDMENT
  DRAWING
  PERMIT
  REPORT
  OTHER
}

enum PaymentStatus {
  PENDING
  INVOICED
  PAID
}

enum ReminderCategory {
  DEADLINE
  MEETING
  SUBMITTAL
  AUDIT
  IMPROVEMENT
  OTHER
}

enum ReminderStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  DONE
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  DONE
  OVERDUE
}

enum EhsType {
  SAFETY
  ENVIRONMENT
  TRAFFIC
  HEALTH
}

enum EhsResult {
  PENDING
  PASS
  FAIL
  IMPROVING
}

enum SubmittalCategory {
  DESIGN
  CONSTRUCTION
  MATERIAL
  TEST_REPORT
}

enum SubmittalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
}

enum ReviewResult {
  PENDING
  APPROVED
  REJECTED
  CONDITIONAL
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  DRAWING
  REPORT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

// ─────────────────────────────────────────────────────────────
// 人員管理 (組織 / 職位 / 帳號)
// ─────────────────────────────────────────────────────────────

/// Organisation unit with self-referencing hierarchy (組織).
model OrgUnit {
  id        String    @id @default(cuid())
  name      String
  code      String?
  parentId  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children OrgUnit[] @relation("OrgTree")
  accounts Account[]

  @@index([parentId])
}

/// Job position / title (職位).
model Position {
  id        String    @id @default(cuid())
  name      String
  rank      Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  accounts      Account[]
  workflowSteps ApprovalWorkflowStep[]
  documentSteps ApprovalDocumentStep[]
}

/// User account / personnel (帳號).
model Account {
  id         String        @id @default(cuid())
  name       String
  email      String        @unique
  phone      String?
  role       AccountRole   @default(ENGINEER)
  status     AccountStatus @default(ACTIVE)
  orgUnitId  String?
  positionId String?
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  orgUnit  OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  appliedDocuments ApprovalDocument[]     @relation("AppliedDocuments")
  signedSteps      ApprovalDocumentStep[] @relation("SignedSteps")
  projectMembers   ProjectMember[]

  @@index([orgUnitId])
  @@index([positionId])
}

enum AccountRole {
  ADMIN
  MANAGER
  ENGINEER
  INSPECTOR
  VIEWER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

// ─────────────────────────────────────────────────────────────
// 簽核管理 (流程範本 / 簽核文件 / 附件)
// ─────────────────────────────────────────────────────────────

/// Approval workflow template (簽核流程範本).
model ApprovalWorkflow {
  id          String                 @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime               @default(now())
  deletedAt   DateTime?
  steps       ApprovalWorkflowStep[]
  documents   ApprovalDocument[]
}

/// A position that must sign at a given order (流程關卡).
model ApprovalWorkflowStep {
  id         String @id @default(cuid())
  workflowId String
  order      Int
  positionId String

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position Position         @relation(fields: [positionId], references: [id])

  @@index([workflowId])
}

/// An approval document routed through a workflow (簽核文件).
model ApprovalDocument {
  id          String                 @id @default(cuid())
  title       String
  description String?
  applicantId String
  workflowId  String
  status      ApprovalStatus         @default(PENDING)
  currentStep Int                    @default(0)
  createdAt   DateTime               @default(now())
  deletedAt   DateTime?

  applicant   Account                @relation("AppliedDocuments", fields: [applicantId], references: [id])
  workflow    ApprovalWorkflow       @relation(fields: [workflowId], references: [id])
  steps       ApprovalDocumentStep[]
  attachments ApprovalAttachment[]

  @@index([applicantId])
  @@index([status])
}

/// A single sign-off step within a document (文件簽核關卡).
model ApprovalDocumentStep {
  id         String       @id @default(cuid())
  documentId String
  order      Int
  positionId String
  signedById String?
  signedAt   DateTime?
  decision   StepDecision @default(PENDING)
  comment    String?

  document ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position Position         @relation(fields: [positionId], references: [id])
  signedBy Account?         @relation("SignedSteps", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([documentId])
}

/// Reference file attached to an approval document (參考文件).
model ApprovalAttachment {
  id         String   @id @default(cuid())
  documentId String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  document ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StepDecision {
  PENDING
  APPROVED
  REJECTED
}
