// PMIS — AI-Powered Construction Supervision
// Prisma 7 schema. The datasource URL lives in prisma.config.ts.
// Models are organised by the 8 functional modules (PMIS-01 ~ PMIS-08).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Core hub — Project (PMIS-03 契約履約管理 base)
// ─────────────────────────────────────────────────────────────

/// A construction project under supervision.
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  location    String?
  contractNo  String?
  client      String?
  contractor  String?
  supervisor  String?
  budget      Decimal?
  floorArea   Decimal? // 樓地板面積 (m²)，供碳排強度基準使用
  lat         Float? // 工地緯度 (WGS84)，供 PMIS-12 GIS 地圖定位
  lng         Float? // 工地經度 (WGS84)
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  workItems         WorkItem[]
  inspections       Inspection[]
  defects           Defect[]
  contractChanges   ContractChange[]
  obligations       ContractObligation[]
  paymentNodes      PaymentNode[]
  documents         ProjectDocument[]
  reminders         ReminderEvent[]
  notifications     Notification[]
  alertRules        AlertRule[]
  devices           MonitoringDevice[]
  ehsAudits         EhsAudit[]
  submittals        Submittal[]
  mediaAssets       MediaAsset[]
  supervisionReports SupervisionReport[]
  members           ProjectMember[]
  carbonInventories CarbonInventory[]
  vouchers          FinancialVoucher[]
  gisFeatures       GisFeature[]
  faithUploads      FaithUpload[]
  fileFolders       FileFolder[]
  projectFiles      ProjectFile[]
}

/// Staffing — links an account to a project with a project-scoped role (配置人力).
model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  accountId String
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@index([projectId])
  @@index([accountId])
}

enum ProjectMemberRole {
  MANAGER
  SUPERVISOR
  INSPECTOR
  MEMBER
}

// ─────────────────────────────────────────────────────────────
// PMIS-10 溫室氣體碳盤查 (GHG Protocol / ISO 14064-1)
// ─────────────────────────────────────────────────────────────

/// 排放係數版本集（如「環境部排放係數管理表 6.0.4」），支援多版本並存與切換。
model EmissionFactorSet {
  id        String   @id @default(cuid())
  name      String
  version   String // 版本號，如 6.0.4
  year      Int // 適用年度
  gwpSet    String // AR5 / AR6
  source    String // 如：環境部
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  factors     EmissionFactor[]
  inventories CarbonInventory[]
}

/// 排放源類別（版本無關，如：柴油、外購電力、卜特蘭水泥）。
model EmissionCategory {
  id     String      @id @default(cuid())
  scope  CarbonScope
  name   String
  unit   String // 基準單位
  active Boolean     @default(true)

  factors EmissionFactor[]
  entries CarbonEntry[]
}

/// 排放係數（隸屬某版本集之下的某類別）。
model EmissionFactor {
  id         String   @id @default(cuid())
  setId      String
  categoryId String
  value      Decimal // kgCO₂e / unit
  unit       String
  createdAt  DateTime @default(now())

  set      EmissionFactorSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  category EmissionCategory  @relation(fields: [categoryId], references: [id])
  entries  CarbonEntry[]

  @@unique([setId, categoryId])
  @@index([categoryId])
}

/// 單一專案的一次盤查（可依年度/期別分次）。
model CarbonInventory {
  id            String               @id @default(cuid())
  projectId     String
  factorSetId   String? // 本次盤查採用的係數版本
  name          String
  periodStart   DateTime?
  periodEnd     DateTime?
  baselineCo2e  Decimal? // 基準值 (tCO₂e)
  targetCo2e    Decimal? // 減量目標 (tCO₂e)
  intensityBasis CarbonIntensityBasis @default(CONTRACT_AMOUNT)
  verifier      String? // 第三方查證機構
  verifiedAt    DateTime?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  factorSet EmissionFactorSet? @relation(fields: [factorSetId], references: [id])
  entries   CarbonEntry[]
  auditLogs CarbonAuditLog[]

  @@index([projectId])
}

/// 單筆活動數據記錄（活動量 × 排放係數 = 排放量）。
model CarbonEntry {
  id           String            @id @default(cuid())
  inventoryId  String
  scope        CarbonScope
  categoryId   String
  factorId     String?
  workItemId   String?
  activityQty  Decimal // 活動數據數量
  activityUnit String // 輸入單位
  factorValue  Decimal // 計算當下的係數快照 (kgCO₂e/unit)
  co2e         Decimal // 計算結果 (kgCO₂e)
  status       CarbonEntryStatus @default(DRAFT)
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證自動擷取
  occurredAt   DateTime?
  evidenceUrl  String? // 憑證/發票連結
  verifiedById String? // 查證人 (Account)
  verifiedAt   DateTime?
  note         String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  inventory CarbonInventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  category  EmissionCategory @relation(fields: [categoryId], references: [id])
  factor    EmissionFactor?  @relation(fields: [factorId], references: [id])
  workItem  WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([scope])
}

/// 稽核軌跡：記錄盤查/記錄的建立、確認、查證、刪除等動作。
model CarbonAuditLog {
  id          String             @id @default(cuid())
  inventoryId String
  entryId     String? // 針對哪一筆記錄（可空 = 針對整份盤查）
  action      String // CREATE / UPDATE / CONFIRM / VERIFY / DELETE / RESTORE
  actorId     String? // Account id
  actorName   String?
  fromStatus  CarbonEntryStatus?
  toStatus    CarbonEntryStatus?
  detail      String?
  createdAt   DateTime           @default(now())

  inventory CarbonInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([entryId])
}

enum CarbonScope {
  SCOPE_1 // 直接排放
  SCOPE_2 // 外購電力
  SCOPE_3 // 上下游
}

enum CarbonEntryStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
  VERIFIED // 已查證
}

enum CarbonIntensityBasis {
  CONTRACT_AMOUNT // 契約金額（預設）
  FLOOR_AREA // 樓地板面積
  DURATION // 工期
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 財務管理（會計傳票／專案損益／現金水位）
// ─────────────────────────────────────────────────────────────

/// 會計傳票（可由憑證經費思自動轉換產生）。
model FinancialVoucher {
  id           String            @id @default(cuid())
  projectId    String
  voucherNo    String? // 傳票號
  date         DateTime
  direction    FinancialDirection
  category     String // 科目／類別，如 工程款、材料、人工、機具、管理費、稅費
  amount       Decimal
  cashFlow     Boolean           @default(true) // 是否影響現金水位
  counterparty String? // 對象（廠商／機關）
  summary      String?
  evidenceUrl  String? // 憑證連結
  aiExtracted  Boolean           @default(false) // 是否由費思自憑證擷取
  status       VoucherStatus     @default(DRAFT)
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([direction])
}

enum FinancialDirection {
  INCOME // 收入
  EXPENSE // 支出
}

enum VoucherStatus {
  DRAFT // 草稿
  CONFIRMED // 已確認
}

// ─────────────────────────────────────────────────────────────
// PMIS-04 時程進度管理
// ─────────────────────────────────────────────────────────────

/// 工程分項：專案下的施工項目，歸屬於某一履約事項。
model WorkItem {
  id           String         @id @default(cuid())
  projectId    String
  obligationId String? // 歸屬履約事項（工程分項→履約事項上捲，選填）
  code         String?
  name         String
  category     String?
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  progress     Int            @default(0) // percent 0-100
  status       WorkItemStatus @default(NOT_STARTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  obligation   ContractObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  inspections  Inspection[]
  defects      Defect[]
  carbonEntries CarbonEntry[]

  @@index([projectId])
  @@index([obligationId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-07 品質稽核管理 (施工查驗 + 缺失)
// ─────────────────────────────────────────────────────────────

/// An inspection / acceptance check (查驗).
model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  workItemId  String?
  type        InspectionType   @default(PROCESS)
  scheduledAt DateTime
  inspector   String?
  result      InspectionResult @default(PENDING)
  location    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  defects  Defect[]

  @@index([projectId])
  @@index([workItemId])
}

/// A quality/safety defect raised during supervision (缺失).
model Defect {
  id           String         @id @default(cuid())
  projectId    String
  workItemId   String?
  inspectionId String?
  title        String
  description  String?
  severity     DefectSeverity @default(MEDIUM)
  status       DefectStatus   @default(OPEN)
  reportedBy   String?
  assignedTo   String?
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem   WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-03 契約履約管理 (變更 / 履約事項 / 付款節點)
// ─────────────────────────────────────────────────────────────

/// Contract change record (契約變更).
model ContractChange {
  id          String    @id @default(cuid())
  projectId   String
  sequence    Int // 變更次數
  description String
  amountAfter Decimal? // 變更後契約金額
  daysChanged Int? // 變更天數
  approvedDate DateTime?
  docNo       String? // 核准文號
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Contract & project document (契約與文件).
model ProjectDocument {
  id         String                  @id @default(cuid())
  projectId  String
  category   ProjectDocumentCategory @default(CONTRACT)
  name       String
  fileNo     String?
  url        String?
  issuedDate DateTime?
  note       String?
  createdAt  DateTime                @default(now())
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// 履約事項：契約應辦事項的統一管制單位。
/// 同時承接進度權重角色——工程分項上捲至此，據以計算全案進度。
model ContractObligation {
  id        String @id @default(cuid())
  projectId String

  code  String // 管制編號，如 WURI-C-001
  title String // 履約事項名稱

  stage       ObligationStage // 階段：概念設計／統包招標／施工監造…
  risk        ObligationRisk    @default(GREEN) // 風險燈號
  triggerType ObligationTrigger @default(FIXED_DATE) // 觸發方式
  status      ObligationStatus  @default(NOT_STARTED)

  dueDate    DateTime? // 期限
  actualDate DateTime? // 實際完成日（進度計算用）

  ownerUnit     String? // 責任單位
  ownerName     String? // 責任人
  contractBasis String? // 契約依據，如 契約第二條第八款

  /// 進度權重；工程分項上捲後依此加權計算全案進度
  weight Int @default(1)
  /// 計入試運轉就緒度
  commissioning Boolean @default(false)

  /// RELATIVE_DUE 用：相對基準日的提前／延後天數
  offsetDays Int?
  docNo      String? // 核准文號（展延）
  note       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[] // 歸屬此履約事項的工程分項

  @@unique([projectId, code])
  @@index([projectId])
  @@index([status])
  @@index([stage])
}

/// 履約事項所屬階段
enum ObligationStage {
  CONCEPT_DESIGN // 概念設計
  DETAIL_DESIGN // 細部設計
  TENDER // 統包招標
  CONSTRUCTION // 施工監造
  COMMISSIONING // 試運轉
  HANDOVER // 竣工移交
  OTHER // 其他
}

/// 風險燈號。PURPLE 用於受外部機關進度牽制者。
enum ObligationRisk {
  GREEN // 低
  YELLOW // 中
  ORANGE // 偏高
  RED // 高
  PURPLE // 外部依賴
}

/// 觸發方式
enum ObligationTrigger {
  FIXED_DATE // 固定日期
  RELATIVE_DUE // 相對期限
  PREDECESSOR // 前置事項完成後起算
  CONDITION // 條件觸發
}

/// 辦理狀態
enum ObligationStatus {
  NOT_STARTED // 未起算
  IN_PROGRESS // 辦理中
  PENDING_REVIEW // 待審
  PENDING_EXTERNAL // 待機關（外部）
  OVERDUE // 逾期
  DONE // 完成
}

/// Payment / valuation node (付款節點 / 計價).
model PaymentNode {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  amount      Decimal?
  plannedDate DateTime?
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-01 行事曆提醒及預警
// ─────────────────────────────────────────────────────────────

/// Calendar event / reminder (行事曆事件與預警).
model ReminderEvent {
  id        String           @id @default(cuid())
  projectId String
  title     String
  category  ReminderCategory @default(OTHER)
  dueDate   DateTime
  status    ReminderStatus   @default(UPCOMING)
  note      String?
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────
// PMIS-02 系統通知
// ─────────────────────────────────────────────────────────────

/// 系統通知。以鈴鐺與未讀數呈現，可展開細節、釘選並前往對應模組。
model Notification {
  id        String     @id @default(cuid())
  projectId String
  title     String
  detail    String? // 通知細節（展開後顯示）
  link      String? // 前往對應功能的路由，如 /quality?project=xxx
  unit      String? // 負責單位
  assignee  String?
  source    String? // 來源 (缺失 / 退件 / 待簽核…)
  dueDate   DateTime?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime? // 已讀時間
  pinnedAt  DateTime? // 釘選時間；非 null 表示固定顯示於釘選區
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([pinnedAt])
}

// ─────────────────────────────────────────────────────────────
// PMIS-05 環安衛管理
// ─────────────────────────────────────────────────────────────

/// Environment / Health & Safety / Traffic audit (環安衛稽核).
model EhsAudit {
  id         String    @id @default(cuid())
  projectId  String
  type       EhsType   @default(SAFETY)
  auditedAt  DateTime
  inspector  String?
  location   String?
  result     EhsResult @default(PENDING)
  findings   String? // 缺失情形
  dueDate    DateTime? // 改善期限
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments EhsAttachment[]
  notes       EhsNote[]

  @@index([projectId])
  @@index([type])
}

/// 檔案管理（PMIS-13）的資料夾。以專案為根目錄，parentId 為 null 即位於根層。
/// 既有模組的附件（環安衛、簽核、費思）不進此表，於讀取時以唯讀虛擬資料夾呈現，
/// 因為那些檔案被稽核與簽核紀錄引用，不應被自由搬移或刪除。
model FileFolder {
  id        String  @id @default(cuid())
  projectId String
  parentId  String?
  name      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    ProjectFile[]

  /// 同一層不得同名；上傳時的重名由服務層自動加序號後才寫入。
  @@unique([projectId, parentId, name])
  @@index([projectId])
  @@index([parentId])
}

/// 直接上傳到檔案管理的檔案。位元組存於儲存區（storage.service），此處僅中繼資料。
model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  /// null 表示位於專案根目錄。
  folderId  String?

  fileName   String
  storedName String
  mimeType   String
  size       Int

  uploadedById String?
  uploadedBy   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  FileFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
}

/// 費思 AI 對話中上傳的檔案歸檔。
/// 位元組存於本機儲存區（見 storage.service），此處僅保存中繼資料，
/// 欄位刻意與 SavedFile 對齊（fileName/storedName/mimeType/size）。
/// projectId 可為 null —— 對話未鎖定專案時歸入「未指派」，事後可補指派。
model FaithUpload {
  id        String  @id @default(cuid())
  projectId String?

  fileName   String // 使用者原始檔名
  storedName String // 儲存區內的不透明檔名
  mimeType   String
  size       Int

  /// 來源任務 id（如 project-wizard）；一般對話為 null。
  taskId    String?
  /// 來源任務名稱，供資料庫頁顯示來源脈絡。
  taskTitle String?
  /// 上傳時附帶的使用者訊息（截斷保存），用以回溯當時的意圖。
  prompt String?

  /// 上傳者。保留 id 以便「未指派專案」時仍能判定存取權。
  uploadedById String?
  uploadedBy   String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedById])
  @@index([createdAt])
}

/// 環安衛稽核之上傳／拍攝文件。
model EhsAttachment {
  id         String   @id @default(cuid())
  auditId    String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

/// 環安衛稽核之追蹤紀錄（改善進度、備註）。
model EhsNote {
  id         String   @id @default(cuid())
  auditId    String
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())

  audit EhsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ─────────────────────────────────────────────────────────────
// PMIS-06 送審文件材料管理
// ─────────────────────────────────────────────────────────────

/// Submittal for design / construction / material / test report (送審).
model Submittal {
  id                String            @id @default(cuid())
  projectId         String
  category          SubmittalCategory @default(MATERIAL)
  name              String
  materialName      String?
  plannedSubmitDate DateTime?
  actualSubmitDate  DateTime?
  reviewDate        DateTime?
  reviewResult      ReviewResult      @default(PENDING)
  status            SubmittalStatus   @default(DRAFT)
  fileNo            String? // 歸檔編號
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// PMIS-08 文件/照片/影片資料庫 + 監造報表
// ─────────────────────────────────────────────────────────────

/// Media / document asset (文件 / 照片 / 影片).
model MediaAsset {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  type       MediaType @default(PHOTO)
  category   String?
  fileUrl    String?
  fileSizeKb Int?
  uploadedBy String?
  capturedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

/// Daily supervision report (監造報表).
model SupervisionReport {
  id         String       @id @default(cuid())
  projectId  String
  reportDate DateTime
  weather    String?
  summary    String? // 按圖施工概況
  manpower   String? // 工地人員及機具
  equipment  String?
  keyNotes   String? // 重要事項
  filedBy    String?
  status     ReportStatus @default(DRAFT)
  createdAt  DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportDate])
  @@index([projectId])
}

